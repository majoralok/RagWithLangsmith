# Hugging Face Inference Providers (open-source LLM)
HF_TOKEN=hf_your_token
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_PROVIDER=auto

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_your_key
LANGSMITH_PROJECT=python-rag-retriever-tracing

# RAG settings
CHROMA_PATH=.rag_index
COLLECTION_NAME=knowledge_base
TOP_K=4
MIN_RELEVANCE_SCORE=0.0
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_NEW_TOKENS=512
LLM_TEMPERATURE=0.1

